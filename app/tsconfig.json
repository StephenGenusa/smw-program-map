{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "strict": true, "noUncheckedIndexedAccess": false, "skipLibCheck": true,
    "resolveJsonModule": true, "esModuleInterop": true, "noEmit": true,
    "types": ["node"]
  },
  "include": ["src", "test", "tools", "e2e", "*.ts"]
}
