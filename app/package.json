{
  "name": "smw-program-map",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only zoomable map of SIMPL Windows programs",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
