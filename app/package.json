{
  "name": "smw-program-map",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only zoomable map of SIMPL Windows programs",
  "author": "Stephen Genusa",
  "license": "MIT",
  "main": "out/main/index.js",
  "type": "module",
  "desktopName": "smw-program-map.desktop",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test": "electron-vite build && vitest run",
    "typecheck": "tsc --noEmit",
    "e2e": "electron-vite build && playwright test",
    "icon": "node build/make-icon.mjs",
    "package": "npm run build:linux",
    "build:unpack": "electron-vite build && electron-builder --dir",
    "build:linux": "electron-vite build && electron-builder --linux",
    "build:win": "electron-vite build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac dir && node scripts/build/zip-mac.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "elkjs": "^0.12.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "pixi.js": "^8.22.0"
  }
}
